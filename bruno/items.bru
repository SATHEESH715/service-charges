meta {
  name: Service charges returns three items
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/charges
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("returns three items", function() {
    expect(res.getBody().length).to.equal(3);
  });

  test("each item has an id, number and name", function() {
    res.getBody().forEach(function(i) {
      expect(i).to.have.property("id");
      expect(i).to.have.property("number");
      expect(i).to.have.property("name");
    });
  });
}
